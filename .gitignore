# Артефакты сборки и локальный компилятор Kiva
/build/
/.kiva/

# Секреты: токен бота хранится только в .env
.env
.env.*
!.env.example

# Логи и дампы памяти (только в корне: src/core.k — исходник)
*.log
/core
/core.[0-9]*

# Кэш Python от скриптов в assets/ и tests/
__pycache__/

# Редакторы и ОС
.vscode/
.idea/
*.swp
*~
.DS_Store
