# Скопируйте этот файл в .env и впишите токен, который выдал @BotFather.
BOT_TOKEN=

# Необязательно: адрес Bot API без завершающего «/» (по умолчанию https://api.telegram.org).
# TELEGRAM_API_URL=https://api.telegram.org

# Необязательно: если Telegram недоступен напрямую, libcurl сам использует прокси из окружения.
# all_proxy=socks5h://127.0.0.1:1080
