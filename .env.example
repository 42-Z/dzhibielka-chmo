# Скопируйте этот файл в .env и заполните значения.

# Токен бота, который выдал @BotFather.
BOT_TOKEN=

# Строка подключения к Postgres. Схему (sql/schema.sql) бот применяет сам при каждом запуске.
DATABASE_URL=postgresql://user:password@localhost:5432/bot

# Telegram-id админов через запятую: им приходят заявки на проверку.
# Свой id покажет команда /id в чате с ботом.
ADMIN_IDS=

# Канал, куда бот публикует работы: @имя или числовой id вида -100…
# Бот должен быть админом канала с правом публикации сообщений.
CHANNEL_ID=

# Необязательно: адрес Bot API без завершающего «/» (по умолчанию https://api.telegram.org).
# TELEGRAM_API_URL=https://api.telegram.org

# Необязательно: путь к файлу схемы (по умолчанию sql/schema.sql относительно каталога запуска).
# SCHEMA_FILE=sql/schema.sql

# Необязательно: каталог с баннерами экранов (по умолчанию assets/banners относительно каталога запуска).
# BANNERS_DIR=assets/banners

# Необязательно: если Telegram недоступен напрямую, libcurl сам использует прокси из окружения.
# all_proxy=socks5h://127.0.0.1:1080
