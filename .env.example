# Скопируйте этот файл в .env и заполните значения.

# Токен бота, который выдал @BotFather.
BOT_TOKEN=

# Строка подключения к Postgres. Схему (sql/schema.sql) бот применяет сам при каждом запуске.
DATABASE_URL=postgresql://user:password@localhost:5432/bot

# Telegram-id админов через запятую: им приходят заявки на проверку.
# Свой id покажет команда /id в чате с ботом.
ADMIN_IDS=

# Канал, куда бот публикует работы: @имя или числовой id вида -100…
# Бот должен быть админом канала с правом публикации сообщений.
CHANNEL_ID=
